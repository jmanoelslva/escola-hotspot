# O instalar.bat copia este arquivo para .env na primeira instalação.

# IP do MikroTik. Só o IP = o painel usa HTTPS se o www-ssl estiver ativo,
# senão HTTP. Para forçar, escreva https://192.168.88.1 ou http://192.168.88.1
MIKROTIK_URL=192.168.88.1
# Certificado próprio (autoassinado) do roteador: deixe "nao".
MIKROTIK_VERIFICAR_TLS=nao
MIKROTIK_TIMEOUT=10

# Porta do painel neste computador: http://IP-DESTE-PC:8080
HOST=0.0.0.0
PORTA=8080

# Minutos sem uso até pedir login de novo.
SESSAO_MINUTOS=60

# Redes do Wi-Fi (separadas por vírgula): quem vem delas só acessa a página
# de troca de senha (/senha); o resto do painel continua fechado para elas.
REDES_WIFI=10.0.0.0/22

NOME_ESCOLA=Escola Estadual Professora Maria Aldineide Pessoa Gomes
CIDADE_ESCOLA=Coité do Noia - AL
